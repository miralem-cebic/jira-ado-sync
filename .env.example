# Secrets the sync reads from its environment (Azure Functions app settings, or Key Vault references).
# The configuration file names each setting, never its value; the names below are examples and must match it.
# Copy to .env or local.settings.json for local runs. Never commit real values.

# API token of the dedicated Jira service account. Named by jira.apiTokenSetting (config.example.json uses this name).
JIRA_API_TOKEN=

# Azure DevOps personal access token, only for local testing with azureDevOps.authMode "pat". Named by
# azureDevOps.patSetting. In Azure the Function uses its managed identity and needs no token.
ADO_PAT=
