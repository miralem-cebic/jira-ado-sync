{
  "$schema": "./config.schema.json",

  "jira": {
    "siteUrl": "https://your-site.atlassian.net",
    "authMode": "apiToken",
    "apiTokenSetting": "JIRA_API_TOKEN",
    "accountEmail": "sync-service@example.com",
    "serviceAccountId": "your-jira-service-account-id",
    "webhookSecretSetting": "JIRA_WEBHOOK_SECRET"
  },

  "azureDevOps": {
    "organization": "your-org",
    "authMode": "managedIdentity",
    "serviceIdentity": "your-sync-identity",
    "webhookUserSetting": "ADO_WEBHOOK_USER",
    "webhookPasswordSetting": "ADO_WEBHOOK_PASSWORD"
  },

  "conflictPolicy": "lastWriteWins",

  "features": {
    "title": true,
    "description": true,
    "status": true,
    "assignee": true
  },

  "projectMappings": [
    {
      "jiraProject": "PROJ",
      "adoProject": "your-ado-project",
      "areaPath": "your-ado-project\\Team A",
      "statusMap": {
        "To Do": "New",
        "In Progress": "Active",
        "Done": "Closed"
      }
    }
  ]
}
