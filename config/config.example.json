{
  "$schema": "./config.schema.json",

  "jira": {
    "siteUrl": "https://your-site.atlassian.net",
    "authMode": "apiToken",
    "apiTokenSetting": "JIRA_API_TOKEN"
  },

  "azureDevOps": {
    "organization": "your-org",
    "authMode": "managedIdentity"
  },

  "conflictPolicy": "lastWriteWins",

  "features": {
    "title": true,
    "description": true,
    "status": true,
    "assignee": true
  },

  "projectMappings": [
    {
      "jiraProject": "PROJ",
      "adoProject": "your-ado-project",
      "areaPath": "your-ado-project\\Team A",
      "statusMap": {
        "To Do": "New",
        "In Progress": "Active",
        "Done": "Closed"
      }
    }
  ]
}
