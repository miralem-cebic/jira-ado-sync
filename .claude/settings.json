{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(dotnet restore*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/local.settings.json)",
      "Bash(git push --force*)"
    ]
  }
}
